                },
                "table_caption": [],
                "table_footnote": [
                    {
                        "type": "text",
                        "content": "技术要求："
                    },
                    {
                        "type": "text",
                        "content": "1、弹簧小径3.2MM，大径6.5mm，"
                    },
                    {
                        "type": "text",
                        "content": "2、材料：线径0.5mm 镀镍不锈钢线。"
                    },
                    {
                        "type": "text",
                        "content": "3、弹簧要求能上锡焊接。"
                    },
                    {
                        "type": "text",
                        "content": "4、弹簧表面要求不能有油污。"
                    },
                    {
                        "type": "text",
                        "content": "5、未注公差尺寸按±0.2mm，角度按±2 "
                    },
                    {
                        "type": "text",
                        "content": "6、须过盐雾浓度为5%（±0.5%）24h "
                    },
                    {
                        "type": "text",
                        "content": "7、弹簧在压缩5mm时,压力≥0.5kgf。"
                    },
                    {
                        "type": "text",
                        "content": "8、标示序号的尺寸为检验尺寸。"
                    }
                ],
