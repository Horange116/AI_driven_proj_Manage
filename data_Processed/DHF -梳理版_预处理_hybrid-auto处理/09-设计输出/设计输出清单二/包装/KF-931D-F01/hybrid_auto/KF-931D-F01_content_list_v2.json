                "list_type": "text_list",
                "list_items": [
                    {
                        "item_type": "text",
                        "item_content": [
                            {
                                "type": "text",
                                "content": "1. 底铺板支承面积不小于 0.42m²"
                            }
                        ]
                    },
                    {
                        "item_type": "text",
                        "item_content": [
                            {
                                "type": "text",
                                "content": "2. 托盘两对角线长度之差不大于 15.6"
                            }
                        ]
                    },
                    {
                        "item_type": "text",
                        "item_content": [
                            {
                                "type": "text",
                                "content": "3. 平面度：顶铺板偏离预定水平面垂直偏差不大于 7.0"
                            }
                        ]
                    },
                    {
                        "item_type": "text",
                        "item_content": [
                            {
                                "type": "text",
                                "content": "4. 托盘动载不小于 1000kg"
                            }
                        ]
                    },
                    {
                        "item_type": "text",
                        "item_content": [
                            {
                                "type": "text",
                                "content": "5. 若构件使用钉紧固，要求钉端头、钉尖不得伸出构件"
                            }
                        ]
                    },
                    {
                        "item_type": "text",
                        "item_content": [
                            {
                                "type": "text",
                                "content": "6. 托盘要求通过《联运通用平托盘试验方法》（GB/T 4996-1996）测试"
                            }
                        ]
                    }
                ]
