            "type": "table",
            "content": {
                "table_caption": [],
                "html": "<table><tr><td colspan=\"2\"><p><strong>测试机型：PT9L</strong></p></td></tr><tr><td><p><strong>测试目的：PT9L性能测试</strong></p></td><td><p><strong>测试时间：</strong></p></td></tr><tr><td><p><strong>测试人员：</strong></p></td><td><p><strong>审核：</strong></p></td></tr></table>",
                "table_type": "complex_table",
