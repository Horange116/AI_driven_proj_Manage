    {
        "type": "text",
        "text": "检测报告正文",
        "text_level": 1,
        "bbox": [
            401,
            92,
            588,
            118
        ],
        "page_idx": 5
    },
    {
        "type": "text",
        "text": "1 目的",
        "text_level": 1,
        "bbox": [
            145,
            135,
            231,
            155
        ],
        "page_idx": 5
    },
    {
        "type": "text",
        "text": "该试验系统用新西兰兔来检测试验样品浸提液与试验系统直接接触引起的皮肤刺激反应，并类推到人类，但试验结果并不代表样品真正的皮肤刺激反应危险性。",
        "bbox": [
            144,
            162,
            845,
            195
        ],
        "page_idx": 5
    },
    {
        "type": "text",
        "text": "2 参考标准",
        "text_level": 1,
        "bbox": [
            145,
            210,
            280,
            230
        ],
        "page_idx": 5
    },
    {
        "type": "text",
        "text": "GB/T 16886.10-2017 医疗器械生物学评价 第10部分：刺激与皮肤致敏试验",
        "bbox": [
            179,
            238,
            773,
            254
        ],
        "page_idx": 5
    },
