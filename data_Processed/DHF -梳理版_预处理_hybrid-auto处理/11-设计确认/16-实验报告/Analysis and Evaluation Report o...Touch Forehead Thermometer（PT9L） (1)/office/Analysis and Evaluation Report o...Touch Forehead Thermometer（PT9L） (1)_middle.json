                                    "spans": [
                                        {
                                            "type": "table",
                                            "html": "<table><tr><td><p>Operating conditions</p></td><td><p>Transportation and storage conditions</p></td></tr><tr><td><p>1) Temperature: 10℃ ~40℃.</p><p>2) Relative humidity:15%RH-95%RH,</p><p>non-condensing.<a></a> </p><p>3) Atm. pressure: 70 kPa ~ 106 kPa.</p></td><td><p>1) Temperature: -20℃ ~55℃.</p><p>2) Relative humidity: 15%RH-95%RH, non-condensing.</p><p>3) Atm. pressure: 70 kPa ~ 106 kPa.</p></td></tr></table>"
                                        }
