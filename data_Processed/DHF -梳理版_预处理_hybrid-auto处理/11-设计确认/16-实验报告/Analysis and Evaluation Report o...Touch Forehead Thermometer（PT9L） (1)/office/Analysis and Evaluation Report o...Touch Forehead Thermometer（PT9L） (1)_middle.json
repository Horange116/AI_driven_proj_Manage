                            "lines": [
                                {
                                    "spans": [
                                        {
                                            "type": "text",
                                            "content": "Use an alcohol swab or tissue moistened with alcohol (70% Isopropyl) to clean. the thermometer casing thoroughly, ideally for more than 15 seconds."
