                    "lines": [
                        {
                            "spans": [
                                {
                                    "type": "text",
                                    "content": "Considering the actual usage of the Infrared No-Touch Forehead Thermometer, the expected use environment is an indoor room temperature environment. When verifying the Expected Life, the application environment adopts the temperature 25℃ and relative humidity 50%, and the accelerated environment adopts the temperature 40℃ and relative humidity 95%."
                                }
                            ]
                        }
                    ],
                    "index": 13
                },
