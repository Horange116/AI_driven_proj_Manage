                    ],
                    "index": 14
                },
                {
                    "type": "text",
                    "lines": [
                        {
                            "spans": [
                                {
                                    "type": "text",
                                    "content": "The thermometer is designed for home use. If there are multiple users, please clean the device in between uses with the following steps:"
